# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider abstraction (set which provider is active)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# PubChem (public, no key required, but URL kept configurable)
PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# Literature APIs
NCBI_EUTILS_API_KEY=
NCBI_EUTILS_EMAIL=your-email@example.com
CROSSREF_MAILTO=your-email@example.com
SEMANTIC_SCHOLAR_API_KEY=
